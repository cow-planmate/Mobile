{
  "$metadata": {
    "tokenSetOrder": ["global", "light", "dark"]
  },
  "$themes": [
    {
      "id": "planmate-light",
      "name": "Light",
      "group": "Mode",
      "selectedTokenSets": { "global": "source", "light": "enabled" },
      "$figmaStyleReferences": {},
      "$figmaVariableReferences": {},
      "$figmaCollectionId": "",
      "$figmaModeId": ""
    },
    {
      "id": "planmate-dark",
      "name": "Dark",
      "group": "Mode",
      "selectedTokenSets": { "global": "source", "dark": "enabled" },
      "$figmaStyleReferences": {},
      "$figmaVariableReferences": {},
      "$figmaCollectionId": "",
      "$figmaModeId": ""
    }
  ],

  "global": {
    "blue": {
      "50":  { "$type": "color", "$value": "#EBEFFF", "$description": "선택 상태 배경, 옅은 tint" },
      "100": { "$type": "color", "$value": "#D6DEFF", "$description": "컨테이너 배경" },
      "200": { "$type": "color", "$value": "#B3C2FF", "$description": "비활성 강조" },
      "300": { "$type": "color", "$value": "#859DFF", "$description": "다크모드 primary · 다크 배경 대비 7.57:1" },
      "400": { "$type": "color", "$value": "#4D70FF", "$description": "큰 텍스트 전용 · 흰 배경 4.14:1" },
      "500": { "$type": "color", "$value": "#1344FF", "$description": "브랜드 · 주 액션 · 흰 배경 6.32:1" },
      "600": { "$type": "color", "$value": "#0F36D6", "$description": "Pressed · 링크 · 흰 배경 8.34:1" },
      "700": { "$type": "color", "$value": "#0E2DAA", "$description": "강조 텍스트" },
      "800": { "$type": "color", "$value": "#0E247C", "$description": "다크모드 컨테이너" },
      "900": { "$type": "color", "$value": "#0E1C53", "$description": "다크모드 onPrimary" }
    },

    "gray": {
      "0":   { "$type": "color", "$value": "#FFFFFF" },
      "50":  { "$type": "color", "$value": "#F9FAFB" },
      "100": { "$type": "color", "$value": "#F3F4F6" },
      "200": { "$type": "color", "$value": "#E5E7EB", "$description": "기본 테두리" },
      "300": { "$type": "color", "$value": "#D1D5DB", "$description": "입력 테두리" },
      "400": { "$type": "color", "$value": "#9CA3AF", "$description": "텍스트 사용 금지 (2.54:1). 아이콘·테두리 전용" },
      "500": { "$type": "color", "$value": "#6B7280", "$description": "보조 텍스트 최저 등급 (4.83:1)" },
      "600": { "$type": "color", "$value": "#4B5563", "$description": "라벨 (7.0:1)" },
      "700": { "$type": "color", "$value": "#374151" },
      "800": { "$type": "color", "$value": "#1F2937" },
      "900": { "$type": "color", "$value": "#111827", "$description": "본문 (16.1:1)" },
      "950": { "$type": "color", "$value": "#0B0F17", "$description": "다크모드 배경" }
    },

    "red": {
      "text":   { "$type": "color", "$value": "#D92D20", "$description": "라이트 오류 텍스트 4.83:1" },
      "border": { "$type": "color", "$value": "#F04438", "$description": "비텍스트 3.76:1" },
      "bg":     { "$type": "color", "$value": "#FEF3F2" },
      "onDark": { "$type": "color", "$value": "#F97066" },
      "bgDark": { "$type": "color", "$value": "#2C1512" }
    },
    "green": {
      "text":   { "$type": "color", "$value": "#067647", "$description": "라이트 성공 텍스트 5.69:1" },
      "border": { "$type": "color", "$value": "#12B76A" },
      "bg":     { "$type": "color", "$value": "#ECFDF3" },
      "onDark": { "$type": "color", "$value": "#32D583" }
    },
    "amber": {
      "text":   { "$type": "color", "$value": "#B54708", "$description": "라이트 경고 텍스트 5.43:1" },
      "border": { "$type": "color", "$value": "#F79009" },
      "bg":     { "$type": "color", "$value": "#FFFAEB" },
      "onDark": { "$type": "color", "$value": "#FDB022" }
    },

    "space": {
      "1": { "$type": "spacing", "$value": "4",  "$description": "아이콘 ↔ 텍스트" },
      "2": { "$type": "spacing", "$value": "8",  "$description": "그룹 내 항목" },
      "3": { "$type": "spacing", "$value": "12" },
      "4": { "$type": "spacing", "$value": "16", "$description": "그룹 ↔ 그룹" },
      "5": { "$type": "spacing", "$value": "20", "$description": "화면 좌우 여백" },
      "6": { "$type": "spacing", "$value": "24" },
      "7": { "$type": "spacing", "$value": "32", "$description": "섹션 ↔ 섹션 / Viewing 하단" },
      "8": { "$type": "spacing", "$value": "40" },
      "9": { "$type": "spacing", "$value": "48" }
    },

    "radius": {
      "xs":   { "$type": "borderRadius", "$value": "6",    "$description": "배지, 칩 내부" },
      "sm":   { "$type": "borderRadius", "$value": "10",   "$description": "소형 버튼, 태그" },
      "md":   { "$type": "borderRadius", "$value": "14",   "$description": "입력 필드, 기본 버튼" },
      "lg":   { "$type": "borderRadius", "$value": "20",   "$description": "카드, 모달" },
      "xl":   { "$type": "borderRadius", "$value": "26",   "$description": "바텀시트, 다이얼로그" },
      "full": { "$type": "borderRadius", "$value": "9999", "$description": "아바타, 원형 아이콘 버튼" }
    },

    "border": {
      "hairline": { "$type": "borderWidth", "$value": "1" },
      "focus":    { "$type": "borderWidth", "$value": "1.5" },
      "selected": { "$type": "borderWidth", "$value": "2" }
    },

    "size": {
      "touchMin":   { "$type": "sizing", "$value": "48", "$description": "터치 타깃 최소 (Material / One UI)" },
      "buttonLg":   { "$type": "sizing", "$value": "52" },
      "buttonMd":   { "$type": "sizing", "$value": "44" },
      "buttonSm":   { "$type": "sizing", "$value": "36" },
      "fieldMin":   { "$type": "sizing", "$value": "56" },
      "rowMin":     { "$type": "sizing", "$value": "56", "$description": "리스트 아이템 최소 높이" },
      "header":     { "$type": "sizing", "$value": "56" },
      "tabBar":     { "$type": "sizing", "$value": "60" },
      "fab":        { "$type": "sizing", "$value": "56" },
      "chip":       { "$type": "sizing", "$value": "36" },
      "dayTab":     { "$type": "sizing", "$value": "48" },
      "hourRow":    { "$type": "sizing", "$value": "80", "$description": "타임라인 시간당 높이 (기존 180)" },
      "iconSm":     { "$type": "sizing", "$value": "16" },
      "iconMd":     { "$type": "sizing", "$value": "20" },
      "iconLg":     { "$type": "sizing", "$value": "24" },
      "avatarSm":   { "$type": "sizing", "$value": "24" },
      "avatarMd":   { "$type": "sizing", "$value": "40" },
      "avatarLg":   { "$type": "sizing", "$value": "64" },
      "contentMax": { "$type": "sizing", "$value": "480", "$description": "600dp 이상 화면에서 콘텐츠 최대 폭" }
    },

    "font": {
      "family": { "$type": "fontFamilies", "$value": "Pretendard" },
      "weight": {
        "regular":  { "$type": "fontWeights", "$value": "Regular" },
        "medium":   { "$type": "fontWeights", "$value": "Medium" },
        "semibold": { "$type": "fontWeights", "$value": "SemiBold" },
        "bold":     { "$type": "fontWeights", "$value": "Bold" }
      }
    },

    "text": {
      "display": {
        "$type": "typography",
        "$description": "화면 대제목 — 로그인/회원가입 스텝/Hero",
        "$value": {
          "fontFamily": "{font.family}", "fontWeight": "{font.weight.bold}",
          "fontSize": "28", "lineHeight": "36", "letterSpacing": "-0.56"
        }
      },
      "title": {
        "$type": "typography",
        "$description": "카드 대제목, 일정 이름",
        "$value": {
          "fontFamily": "{font.family}", "fontWeight": "{font.weight.bold}",
          "fontSize": "22", "lineHeight": "30", "letterSpacing": "-0.4"
        }
      },
      "headline": {
        "$type": "typography",
        "$description": "헤더 타이틀, 모달 제목",
        "$value": {
          "fontFamily": "{font.family}", "fontWeight": "{font.weight.semibold}",
          "fontSize": "18", "lineHeight": "26", "letterSpacing": "-0.22"
        }
      },
      "bodyLg": {
        "$type": "typography",
        "$description": "입력값, 본문 강조, 버튼 라벨",
        "$value": {
          "fontFamily": "{font.family}", "fontWeight": "{font.weight.regular}",
          "fontSize": "16", "lineHeight": "24", "letterSpacing": "0"
        }
      },
      "body": {
        "$type": "typography",
        "$description": "기본 본문",
        "$value": {
          "fontFamily": "{font.family}", "fontWeight": "{font.weight.regular}",
          "fontSize": "14", "lineHeight": "22", "letterSpacing": "0"
        }
      },
      "label": {
        "$type": "typography",
        "$description": "필드 라벨, 탭 라벨, 소형 버튼",
        "$value": {
          "fontFamily": "{font.family}", "fontWeight": "{font.weight.medium}",
          "fontSize": "13", "lineHeight": "18", "letterSpacing": "0"
        }
      },
      "caption": {
        "$type": "typography",
        "$description": "보조 설명, 배지 — 하한선. 이보다 작은 크기 금지",
        "$value": {
          "fontFamily": "{font.family}", "fontWeight": "{font.weight.medium}",
          "fontSize": "12", "lineHeight": "16", "letterSpacing": "0.24"
        }
      }
    },

    "elevation": {
      "flat":   { "$type": "boxShadow", "$value": { "x": "0", "y": "0", "blur": "0", "spread": "0", "color": "#00000000", "type": "dropShadow" }, "$description": "카드·리스트·입력 — 테두리로만 표현" },
      "raised": { "$type": "boxShadow", "$value": { "x": "0", "y": "2", "blur": "8", "spread": "0", "color": "rgba(0,0,0,0.10)", "type": "dropShadow" }, "$description": "FAB·드롭다운·바텀시트·스낵바 — 실제로 떠 있는 것만" }
    }
  },

  "light": {
    "bg":               { "$type": "color", "$value": "{gray.0}" },
    "surface":          { "$type": "color", "$value": "{gray.50}" },
    "surfaceRaised":    { "$type": "color", "$value": "{gray.0}" },
    "border":           { "$type": "color", "$value": "{gray.200}" },
    "borderStrong":     { "$type": "color", "$value": "{gray.300}" },
    "text":             { "$type": "color", "$value": "{gray.900}" },
    "textSecondary":    { "$type": "color", "$value": "{gray.500}" },
    "textDisabled":     { "$type": "color", "$value": "{gray.400}" },
    "primary":          { "$type": "color", "$value": "{blue.500}" },
    "primaryPressed":   { "$type": "color", "$value": "{blue.600}" },
    "onPrimary":        { "$type": "color", "$value": "{gray.0}" },
    "primaryContainer": { "$type": "color", "$value": "{blue.50}" },
    "onPrimaryContainer": { "$type": "color", "$value": "{blue.700}" },
    "error":            { "$type": "color", "$value": "{red.text}" },
    "errorBorder":      { "$type": "color", "$value": "{red.border}" },
    "errorBg":          { "$type": "color", "$value": "{red.bg}" },
    "success":          { "$type": "color", "$value": "{green.text}" },
    "successBg":        { "$type": "color", "$value": "{green.bg}" },
    "warning":          { "$type": "color", "$value": "{amber.text}" },
    "warningBg":        { "$type": "color", "$value": "{amber.bg}" },
    "scrim":            { "$type": "color", "$value": "rgba(16,20,27,0.45)" },

    "category": {
      "sight":   { "accent": { "$type": "color", "$value": "#0E9384" }, "bg": { "$type": "color", "$value": "#F0FDF9" }, "text": { "$type": "color", "$value": "#115E56" } },
      "lodging": { "accent": { "$type": "color", "$value": "#7839EE" }, "bg": { "$type": "color", "$value": "#F4F3FF" }, "text": { "$type": "color", "$value": "#4A1FB8" } },
      "food":    { "accent": { "$type": "color", "$value": "#B54708" }, "bg": { "$type": "color", "$value": "#FFFAEB" }, "text": { "$type": "color", "$value": "#93370D" } },
      "cafe":    { "accent": { "$type": "color", "$value": "#C11574" }, "bg": { "$type": "color", "$value": "#FDF2FA" }, "text": { "$type": "color", "$value": "#9E165F" } },
      "etc":     { "accent": { "$type": "color", "$value": "#475467" }, "bg": { "$type": "color", "$value": "#F2F4F7" }, "text": { "$type": "color", "$value": "#344054" } }
    }
  },

  "dark": {
    "bg":               { "$type": "color", "$value": "{gray.950}" },
    "surface":          { "$type": "color", "$value": "#151A23" },
    "surfaceRaised":    { "$type": "color", "$value": "#1D232E" },
    "border":           { "$type": "color", "$value": "#2A313D" },
    "borderStrong":     { "$type": "color", "$value": "#3A424F" },
    "text":             { "$type": "color", "$value": "#E4E7EC", "$description": "순백 대신 — 야간 헤일레이션 방지. 15.1:1" },
    "textSecondary":    { "$type": "color", "$value": "{gray.400}" },
    "textDisabled":     { "$type": "color", "$value": "{gray.500}" },
    "primary":          { "$type": "color", "$value": "{blue.300}" },
    "primaryPressed":   { "$type": "color", "$value": "{blue.400}" },
    "onPrimary":        { "$type": "color", "$value": "{blue.900}", "$description": "밝은 primary 위 어두운 글자. 6.31:1" },
    "primaryContainer": { "$type": "color", "$value": "{blue.800}" },
    "onPrimaryContainer": { "$type": "color", "$value": "{blue.100}" },
    "error":            { "$type": "color", "$value": "{red.onDark}" },
    "errorBorder":      { "$type": "color", "$value": "{red.onDark}" },
    "errorBg":          { "$type": "color", "$value": "{red.bgDark}" },
    "success":          { "$type": "color", "$value": "{green.onDark}" },
    "successBg":        { "$type": "color", "$value": "#0C2E1D" },
    "warning":          { "$type": "color", "$value": "{amber.onDark}" },
    "warningBg":        { "$type": "color", "$value": "#33230A" },
    "scrim":            { "$type": "color", "$value": "rgba(0,0,0,0.60)" },

    "category": {
      "sight":   { "accent": { "$type": "color", "$value": "#2ED3B7" }, "bg": { "$type": "color", "$value": "#0C2E2A" }, "text": { "$type": "color", "$value": "#99F6E0" } },
      "lodging": { "accent": { "$type": "color", "$value": "#A48AFB" }, "bg": { "$type": "color", "$value": "#241B4D" }, "text": { "$type": "color", "$value": "#D9D6FE" } },
      "food":    { "accent": { "$type": "color", "$value": "#FDB022" }, "bg": { "$type": "color", "$value": "#3A2408" }, "text": { "$type": "color", "$value": "#FEDF89" } },
      "cafe":    { "accent": { "$type": "color", "$value": "#EE46BC" }, "bg": { "$type": "color", "$value": "#3D1030" }, "text": { "$type": "color", "$value": "#FCCEEE" } },
      "etc":     { "accent": { "$type": "color", "$value": "#98A2B3" }, "bg": { "$type": "color", "$value": "#1D232E" }, "text": { "$type": "color", "$value": "#CDD3DC" } }
    }
  }
}
